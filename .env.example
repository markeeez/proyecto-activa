# Copia este archivo como .env y rellena tus valores
# Obtén estas claves en: https://supabase.com → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://tu-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# RLS modelo B (alimentos globales): despliega foods-upsert-global y sube el secreto en Supabase
# (Dashboard → Edge Functions → Secrets, o CLI). No uses nombre SUPABASE_* en un .env para `secrets set`:
# el CLI lo omite. Ejemplo: supabase secrets set SERVICE_ROLE_KEY="eyJ..."
# (vuelve a desplegar la función tras crear el secreto). Nunca pongas la service role en el .env de Expo.

# FatSecret: credenciales SOLO en Supabase (Edge Function fatsecret-search), no en el cliente:
#   npx supabase secrets set FATSECRET_CLIENT_ID=...
#   npx supabase secrets set FATSECRET_CLIENT_SECRET=...
# Opcional (resultados más acordes a España / español):
#   npx supabase secrets set FATSECRET_REGION=ES
#   npx supabase secrets set FATSECRET_LANGUAGE=es
# Despliega: npx supabase functions deploy fatsecret-search
# Si la API responde error 21 (Invalid IP): en platform.fatsecret.com permite la IP de salida
# de Supabase Edge (y la tuya para `npm run test:fatsecret` desde casa).
# Con relay en VPS (ver relay/README.md), en Supabase secrets:
#   FATSECRET_RELAY_URL=https://tu-subdominio.com
#   FATSECRET_RELAY_SECRET=<mismo RELAY_SECRET del servidor>

# Google Sign-In (console.cloud.google.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu_web_client_id.apps.googleusercontent.com
