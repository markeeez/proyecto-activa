# Copiar a /etc/systemd/system/fatsecret-relay.service y ajustar rutas + secreto.
# sudo systemctl daemon-reload && sudo systemctl enable --now fatsecret-relay

[Unit]
Description=FatSecret relay (IP fija Hetzner → FatSecret)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/fatsecret-relay
Environment=PORT=8787
Environment=BIND=127.0.0.1
EnvironmentFile=/etc/fatsecret-relay.env
ExecStart=/usr/bin/node /opt/fatsecret-relay/fatsecret-relay.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
