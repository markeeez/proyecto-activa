{
  "expo": {
    "name": "Vertice",
    "slug": "vertice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icons/icon.png",
    "scheme": "proyectoactiva",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vertice.app",
      "usesAppleSignIn": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/app-icons/android-icon-foreground.png",
        "backgroundImage": "./assets/images/app-icons/android-icon-background.png",
        "monochromeImage": "./assets/images/app-icons/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vertice.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icons/icon.png",
          "color": "#00D4FF",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vertice necesita acceso a tus fotos para que puedas añadir una foto de perfil.",
          "cameraPermission": "Vertice necesita la cámara para hacerte una foto de perfil."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icons/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/app-icons/icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.40080207449-pus0oivi9agger3l3g3ede2vbl23fj54"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Vertice necesita la cámara para fotografiar etiquetas nutricionales y escanear códigos de barras.",
          "microphonePermission": "Vertice puede usar el micrófono si grabas vídeo con la cámara.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "daec3468-e49f-4347-8daa-61c737e5b1d2"
      }
    }
  }
}
